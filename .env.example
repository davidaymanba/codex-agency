# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# Supabase — local values: `npx supabase status`. Hosted: Project Settings → API.
# The service role key is SERVER-ONLY: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
EMAIL_FROM="CODEX <hello@your-domain.com>"

# Cloudflare Turnstile (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics visitor-hash salt (optional; any long random string)
TRACKING_SALT=

